# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-use-a-strong-random-secret

# Database Configuration (Defaults to SQLite in instance directory)
DATABASE_URL=sqlite:///student_results.db

# Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes
